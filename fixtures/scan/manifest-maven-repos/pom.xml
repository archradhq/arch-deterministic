<?xml version="1.0" encoding="UTF-8"?>
<!--
  spring-petclinic-microservices shape: the module declares NO project-level name
  of its own, while the artifact-repository block near the end of the file does.
  A repository name is where Maven fetches jars from, not a component, so reading
  the first one anywhere in the file named this service "Spring Milestones" and
  gave it a driver edge.

  The correct name here comes from the project's own artifactId.
-->
<!--
  Second case, in the same file: this comment contains a literal <repositories>
  tag with no closing partner. A stripper that runs before comments are removed
  would match from here to the real </repositories> at the end of the file and
  swallow the whole project header, losing the artifactId too.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
  </parent>

  <groupId>org.example</groupId>
  <artifactId>spring-petclinic-genai-service</artifactId>
  <version>1.0.0</version>

  <dependencies>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.12</version>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>spring-milestones</id>
      <name>Spring Milestones</name>
      <url>https://repo.spring.io/milestone</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>spring-snapshots</id>
      <name>Spring Snapshots</name>
      <url>https://repo.spring.io/snapshot</url>
    </pluginRepository>
  </pluginRepositories>
</project>
